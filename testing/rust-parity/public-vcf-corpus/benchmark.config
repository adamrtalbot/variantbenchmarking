process {
    errorStrategy = 'terminate'
    maxRetries = 0
    maxErrors = 1

    withName: 'HAPPY_HAPPY' {
        cpus = 6
        memory = 36.GB
    }

    withName: 'HAPPY_SOMPY' {
        cpus = 6
        memory = 36.GB
    }

    withName: 'CREATE_DATAVZRD_INPUT' {
        ext.when = false
    }

    withName: 'DATAVZRD' {
        ext.when = false
    }

    withName: 'MULTIQC' {
        ext.when = false
    }
}
